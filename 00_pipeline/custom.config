// Caps every process to what a 4-core GitHub Codespace can give.
//
// nf-core 3.x dropped the old params.max_cpus / max_memory / max_time. Setting
// them here does nothing except produce a warning, so the limits are expressed
// with Nextflow's resourceLimits directive instead.

process {
    resourceLimits = [ cpus: 4, memory: 14.GB, time: 6.h ]
}
