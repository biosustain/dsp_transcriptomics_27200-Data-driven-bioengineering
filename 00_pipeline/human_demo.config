// Boolean parameters for the human demo run.
//
// These cannot go on the command line. Nextflow reads both a bare '--gencode'
// and '--gencode true' as the *string* "true", and the rnaseq 3.27 schema
// rejects a string where it expects a boolean, so the run stops before any
// work starts. Set here, they are real booleans and validation passes.

params {
    gencode             = true
    skip_markduplicates = true
    skip_biotype_qc     = true
    skip_preseq         = true
    skip_bbsplit        = true
}
