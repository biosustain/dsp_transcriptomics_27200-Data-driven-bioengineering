// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "Ubuntu",
  // Prebuilt image so Codespaces starts in a couple of minutes instead of
  // building R from source. Built from ./Dockerfile by
  // .github/workflows/publish-devcontainer.yml.
  //
  // Pinned to a release so the environment cannot change under students
  // mid-course. To roll out a new image: edit the Dockerfile, cut a new
  // GitHub release (which builds, verifies and publishes it), then bump
  // this tag.
  // 1.1.0 bakes in the AI agent CLIs (Claude Code, Codex) — see the
  // "AI assistants in your Codespace" section of the course book.
  "image": "ghcr.io/biosustain/dsp_transcriptomics_27200-data-driven-bioengineering:1.1.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    // Opens the short instructions as soon as the Codespace is ready, so
    // students do not have to find them. Keeps the README free for GitHub.
    "codespaces": {
      "openFiles": ["START_HERE.md"]
    },
    "vscode": {
      // jupyter-renderers adds the plotly renderer VS Code needs for the
      // interactive widgets in the notebooks.
      // Copilot extensions give students a free AI chat option (GitHub
      // Student Pack) without any extra account setup.
      "extensions": ["REditorSupport.r", "ms-toolsai.jupyter", "ms-toolsai.jupyter-renderers", "GitHub.copilot", "GitHub.copilot-chat"],
      "settings": {
        // The R extension lints notebook cells like script files and floods the
        // Problems panel with style warnings students cannot act on.
        "r.lsp.diagnostics": false,
        // Open START_HERE.md rendered rather than as raw markdown. It is set
        // here as well as in .vscode/settings.json because openFiles above runs
        // as the Codespace starts, which can be before workspace settings are
        // applied. Both globs, since the file sits at the workspace root.
        "workbench.editorAssociations": {
          "START_HERE.md": "vscode.markdown.preview.editor",
          "**/START_HERE.md": "vscode.markdown.preview.editor"
        }
      }
    }
  }
}
