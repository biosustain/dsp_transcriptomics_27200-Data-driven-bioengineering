// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "Ubuntu",
  // Prebuilt image so Codespaces starts in a couple of minutes instead of
  // building R from source. It is built from ./Dockerfile by
  // .github/workflows/publish-devcontainer.yml, which republishes on every
  // change to .devcontainer/ — edit the Dockerfile, not this tag.
  "image": "ghcr.io/biosustain/dsp_transcriptomics_27200-data-driven-bioengineering:latest",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      // jupyter-renderers adds the plotly renderer VS Code needs for the
      // g:Profiler Manhattan plot (gostplot) in the enrichment notebook.
      "extensions": ["REditorSupport.r", "ms-toolsai.jupyter", "ms-toolsai.jupyter-renderers"],
      "settings": {
        // The R extension lints notebook cells like script files and floods the
        // Problems panel with style warnings students cannot act on.
        "r.lsp.diagnostics": false
      }
    }
  }
}
